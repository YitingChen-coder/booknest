# Copy to .env.local and fill in. Never commit .env.local.

# Clerk (Dashboard → API Keys). Publishable key is safe in the browser; secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (Project Settings → API). Use the publishable (anon) key only; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
